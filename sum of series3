#include <bits/stdc++.h>

using namespace std;
int main()
{
    double n, sum1 = 0, sum2 = 0, sum;
    cin >> n;
    for (int i = 0; i <= n; i++)
    {
        if (i % 2 == 0)
            sum1 = sum1 + 1 / pow(n, i);
        else
            sum2 = sum2 + 1 / pow(n, i);
    }
    sum = sum1 - sum2;
    cout << sum;
    return 0;
}